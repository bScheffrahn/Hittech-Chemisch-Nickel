FUNCTION_BLOCK "FB_Ansteuerung_KP8"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      KP8 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : "UDT_KP8";
   END_VAR

   VAR_TEMP 
      i : USInt;
      Maske : Byte;
   END_VAR


BEGIN
	// 1) Eingänge dekodieren
	FOR #i := 0 TO 7 DO
	    #Maske := SHL(IN := BYTE#1, N := #i);
	    
	    #KP8.Taste[#i] := (#KP8.Rohdaten.IB_Tasten AND #Maske) <> BYTE#0;
	    #KP8.DI[#i] := (#KP8.Rohdaten.IB_DI AND #Maske) <> BYTE#0;
	END_FOR;
	
	// 2) Ausgänge neu aufbauen
	#KP8.Rohdaten.QB_Rot := BYTE#0;
	#KP8.Rohdaten.QB_Gruen := BYTE#0;
	#KP8.Rohdaten.QB_Blau := BYTE#0;
	#KP8.Rohdaten.QB_DO := BYTE#0;
	
	// 3) LEDs in Bytes umsetzen
	FOR #i := 0 TO 7 DO
	    #Maske := SHL(IN := BYTE#1, N := #i);
	    
	    CASE #KP8.LED[#i] OF
	        0: // Aus
	            ;
	            
	        1: // Rot
	            #KP8.Rohdaten.QB_Rot := #KP8.Rohdaten.QB_Rot OR #Maske;
	            
	        2: // Grün
	            #KP8.Rohdaten.QB_Gruen := #KP8.Rohdaten.QB_Gruen OR #Maske;
	            
	        3: // Blau
	            #KP8.Rohdaten.QB_Blau := #KP8.Rohdaten.QB_Blau OR #Maske;
	            
	        4: // Gelb
	            #KP8.Rohdaten.QB_Rot := #KP8.Rohdaten.QB_Rot OR #Maske;
	            #KP8.Rohdaten.QB_Gruen := #KP8.Rohdaten.QB_Gruen OR #Maske;
	            
	        5: // Weiß
	            #KP8.Rohdaten.QB_Rot := #KP8.Rohdaten.QB_Rot OR #Maske;
	            #KP8.Rohdaten.QB_Gruen := #KP8.Rohdaten.QB_Gruen OR #Maske;
	            #KP8.Rohdaten.QB_Blau := #KP8.Rohdaten.QB_Blau OR #Maske;
	    END_CASE;
	END_FOR;
	
	// 4) Digitale Ausgänge umsetzen
	FOR #i := 0 TO 7 DO
	    #Maske := SHL(IN := BYTE#1, N := #i);
	    
	    IF #KP8."DO"[#i] THEN
	        #KP8.Rohdaten.QB_DO := #KP8.Rohdaten.QB_DO OR #Maske;
	    END_IF;
	END_FOR;
END_FUNCTION_BLOCK

