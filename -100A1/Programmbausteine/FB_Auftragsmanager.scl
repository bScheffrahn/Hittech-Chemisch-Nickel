FUNCTION_BLOCK "FB_Auftragsmanager"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.4
   VAR_IN_OUT 
      Auftraege : Array[0..9] of "UDT_Prozessroute";
      Bad_Konfig : Array[1.."c_Anzahl_Bad"] of "UDT_Bad_Konfig";
   END_VAR

   VAR 
      Freigabe_Alt : Array[0..9] of Bool;
   END_VAR

   VAR_TEMP 
      i : Int;
      b : Int;
      w : Int;
      ersterBad : Int;
      naechsterBad : Int;
      aktSchrittIdx : Int;
      flanke_Freigabe : Bool;
      auftrag_laeuft : Bool;
      freier_platz : Int;
   END_VAR


BEGIN
	
	    FOR #b:=1 TO "c_Anzahl_Bad" DO FOR #w:=1 TO 3 DO
	        IF #Bad_Konfig[#b].WT[#w].WT_Entnommen THEN
	            #i:=#Bad_Konfig[#b].WT[#w].Auftragsindex; #aktSchrittIdx:=#Bad_Konfig[#b].WT[#w].SchrittIndex;
	            IF (#i>=0)AND(#i<=9) THEN
	                IF (#aktSchrittIdx+1)<#Auftraege[#i].Anzahl_Schritte THEN
	                    // Naechster Schritt: erst pruefen ob Platz frei
	                    #naechsterBad:=#Auftraege[#i].Schritte[#aktSchrittIdx+1].BadNr;
	                    #freier_platz:=0;
	                    IF (#naechsterBad>=1)AND(#naechsterBad<="c_Anzahl_Bad") THEN
	                        IF #Bad_Konfig[#naechsterBad].Ausstattung.HatGleichrichter
	                           AND (#Bad_Konfig[#naechsterBad].WT[1].Belegt OR #Bad_Konfig[#naechsterBad].WT[2].Belegt OR #Bad_Konfig[#naechsterBad].WT[3].Belegt) THEN
	                            #freier_platz:=0;
	                        ELSIF NOT #Bad_Konfig[#naechsterBad].WT[1].Belegt THEN #freier_platz:=1;
	                        ELSIF NOT #Bad_Konfig[#naechsterBad].WT[2].Belegt THEN #freier_platz:=2;
	                        ELSIF NOT #Bad_Konfig[#naechsterBad].WT[3].Belegt THEN #freier_platz:=3; END_IF;
	                    END_IF;
	                    IF #freier_platz>0 THEN
	                        // Platz frei: altes Bad raeumen, neues Bad belegen
	                        #Bad_Konfig[#b].WT[#w].Belegt:=FALSE; #Bad_Konfig[#b].WT[#w].Auftragsindex:=-1; #Bad_Konfig[#b].WT[#w].SchrittIndex:=-1;
	                        #Bad_Konfig[#b].WT[#w].WT_Eingesetzt:=FALSE; #Bad_Konfig[#b].WT[#w].WT_Entnommen:=FALSE;
	                        #Bad_Konfig[#b].WT[#w].Istzeit:=T#0s; #Bad_Konfig[#b].WT[#w].Restzeit:=T#0s;
	                        #Bad_Konfig[#b].WT[#w].Zeit_Abgelaufen:=FALSE; #Bad_Konfig[#b].WT[#w].Krit_Zeit_Abgelaufen:=FALSE; #Bad_Konfig[#b].WT[#w].Vorwarn_Erreicht:=FALSE;
	                        #Bad_Konfig[#naechsterBad].WT[#freier_platz].Auftragsindex:=#i; #Bad_Konfig[#naechsterBad].WT[#freier_platz].SchrittIndex:=#aktSchrittIdx+1;
	                        #Bad_Konfig[#naechsterBad].WT[#freier_platz].Belegt:=TRUE; #Bad_Konfig[#naechsterBad].WT[#freier_platz].WT_Eingesetzt:=FALSE;
	                        #Bad_Konfig[#naechsterBad].WT[#freier_platz].WT_Entnommen:=FALSE; #Bad_Konfig[#naechsterBad].WT[#freier_platz].Zeit_Abgelaufen:=FALSE;
	                        #Bad_Konfig[#naechsterBad].WT[#freier_platz].Krit_Zeit_Abgelaufen:=FALSE; #Bad_Konfig[#naechsterBad].WT[#freier_platz].Vorwarn_Erreicht:=FALSE;
	                        #Bad_Konfig[#naechsterBad].WT[#freier_platz].Protokoll_Neu:=FALSE;
	                    END_IF;
	                    // freier_platz=0: WT bleibt am alten Bad, naechsten Zyklus erneut pruefen
	                ELSE
	                    // Letzter Schritt: raeumen und Auftrag abschliessen
	                    #Bad_Konfig[#b].WT[#w].Belegt:=FALSE; #Bad_Konfig[#b].WT[#w].Auftragsindex:=-1; #Bad_Konfig[#b].WT[#w].SchrittIndex:=-1;
	                    #Bad_Konfig[#b].WT[#w].WT_Eingesetzt:=FALSE; #Bad_Konfig[#b].WT[#w].WT_Entnommen:=FALSE;
	                    #Bad_Konfig[#b].WT[#w].Istzeit:=T#0s; #Bad_Konfig[#b].WT[#w].Restzeit:=T#0s;
	                    #Bad_Konfig[#b].WT[#w].Zeit_Abgelaufen:=FALSE; #Bad_Konfig[#b].WT[#w].Krit_Zeit_Abgelaufen:=FALSE; #Bad_Konfig[#b].WT[#w].Vorwarn_Erreicht:=FALSE;
	                    #Auftraege[#i].Freigabe:=FALSE; #Freigabe_Alt[#i]:=FALSE;
	                    "DB_CPU_to_IPC".Auftrag_Abgeschlossen[#i] := TRUE;
	                END_IF;
	            END_IF;
	        END_IF;
	    END_FOR; END_FOR;
	    FOR #i:=0 TO 9 DO IF #Auftraege[#i].Abbruch THEN
	        FOR #b:=1 TO "c_Anzahl_Bad" DO FOR #w:=1 TO 3 DO
	            IF #Bad_Konfig[#b].WT[#w].Auftragsindex=#i THEN
	                #Bad_Konfig[#b].WT[#w].Belegt:=FALSE; #Bad_Konfig[#b].WT[#w].Auftragsindex:=-1; #Bad_Konfig[#b].WT[#w].SchrittIndex:=-1;
	                #Bad_Konfig[#b].WT[#w].WT_Eingesetzt:=FALSE; #Bad_Konfig[#b].WT[#w].WT_Entnommen:=FALSE;
	                #Bad_Konfig[#b].WT[#w].Istzeit:=T#0s; #Bad_Konfig[#b].WT[#w].Restzeit:=T#0s;
	                #Bad_Konfig[#b].WT[#w].Zeit_Abgelaufen:=FALSE; #Bad_Konfig[#b].WT[#w].Krit_Zeit_Abgelaufen:=FALSE; #Bad_Konfig[#b].WT[#w].Vorwarn_Erreicht:=FALSE;
	            END_IF;
	        END_FOR; END_FOR;
	        #Auftraege[#i].Freigabe:=FALSE; #Auftraege[#i].Abbruch:=FALSE; #Freigabe_Alt[#i]:=FALSE;
	    END_IF; END_FOR;
	    FOR #i:=0 TO 9 DO
	        #flanke_Freigabe:=#Auftraege[#i].Freigabe AND NOT #Freigabe_Alt[#i]; #Freigabe_Alt[#i]:=#Auftraege[#i].Freigabe;
	        // Auftrag_Abgeschlossen zuruecksetzen wenn IPC den Slot aufgeraeumt hat
	        IF #Auftraege[#i].Anzahl_Schritte = 0 THEN "DB_CPU_to_IPC".Auftrag_Abgeschlossen[#i] := FALSE; END_IF;
	        IF #Auftraege[#i].Freigabe AND NOT #Auftraege[#i].Abbruch THEN
	            #auftrag_laeuft:=FALSE;
	            FOR #b:=1 TO "c_Anzahl_Bad" DO FOR #w:=1 TO 3 DO IF #Bad_Konfig[#b].WT[#w].Auftragsindex=#i THEN #auftrag_laeuft:=TRUE; END_IF; END_FOR; END_FOR;
	            IF NOT #auftrag_laeuft AND(#Auftraege[#i].Anzahl_Schritte>=1)AND(#Auftraege[#i].Anzahl_Schritte<=51) THEN
	                #ersterBad:=#Auftraege[#i].Schritte[0].BadNr;
	                IF (#ersterBad>=1)AND(#ersterBad<="c_Anzahl_Bad") THEN
	                    #freier_platz:=0;
	                    // Gleichrichter-Baeder: max. 1 WT gleichzeitig
	                    IF #Bad_Konfig[#ersterBad].Ausstattung.HatGleichrichter
	                       AND (#Bad_Konfig[#ersterBad].WT[1].Belegt OR #Bad_Konfig[#ersterBad].WT[2].Belegt OR #Bad_Konfig[#ersterBad].WT[3].Belegt) THEN
	                        #freier_platz:=0;
	                    ELSIF NOT #Bad_Konfig[#ersterBad].WT[1].Belegt THEN #freier_platz:=1;
	                    ELSIF NOT #Bad_Konfig[#ersterBad].WT[2].Belegt THEN #freier_platz:=2;
	                    ELSIF NOT #Bad_Konfig[#ersterBad].WT[3].Belegt THEN #freier_platz:=3; END_IF;
	                    IF #freier_platz>0 THEN
	                        #Bad_Konfig[#ersterBad].WT[#freier_platz].Auftragsindex:=#i; #Bad_Konfig[#ersterBad].WT[#freier_platz].SchrittIndex:=0;
	                        #Bad_Konfig[#ersterBad].WT[#freier_platz].Belegt:=TRUE; #Bad_Konfig[#ersterBad].WT[#freier_platz].WT_Eingesetzt:=FALSE;
	                        #Bad_Konfig[#ersterBad].WT[#freier_platz].WT_Entnommen:=FALSE; #Bad_Konfig[#ersterBad].WT[#freier_platz].Zeit_Abgelaufen:=FALSE;
	                        #Bad_Konfig[#ersterBad].WT[#freier_platz].Krit_Zeit_Abgelaufen:=FALSE; #Bad_Konfig[#ersterBad].WT[#freier_platz].Vorwarn_Erreicht:=FALSE;
	                        #Bad_Konfig[#ersterBad].WT[#freier_platz].Protokoll_Neu:=FALSE;
	                    END_IF;
	                END_IF;
	            END_IF;
	        END_IF;
	    END_FOR;
	
END_FUNCTION_BLOCK

