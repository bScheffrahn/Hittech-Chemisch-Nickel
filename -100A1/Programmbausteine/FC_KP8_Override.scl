FUNCTION "FC_KP8_Override" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Lampentest : Bool;
      Blink_Takt : Bool;
   END_VAR

   VAR_TEMP 
      i : Int;
      led_val : USInt;
   END_VAR


BEGIN
	
	    IF #Lampentest THEN
	        IF #Blink_Takt THEN #led_val:=5; ELSE #led_val:=0; END_IF;
	        FOR #i:=0 TO 7 DO
	            "FB_KP8_DB_1".KP8.LED[#i]:=#led_val; "FB_KP8_DB_2".KP8.LED[#i]:=#led_val; "FB_KP8_DB_3".KP8.LED[#i]:=#led_val; "FB_KP8_DB_4".KP8.LED[#i]:=#led_val;
	            "FB_KP8_DB_5".KP8.LED[#i]:=#led_val; "FB_KP8_DB_6".KP8.LED[#i]:=#led_val; "FB_KP8_DB_7".KP8.LED[#i]:=#led_val; "FB_KP8_DB_8".KP8.LED[#i]:=#led_val;
	            "FB_KP8_DB_9".KP8.LED[#i]:=#led_val; "FB_KP8_DB_10".KP8.LED[#i]:=#led_val; "FB_KP8_DB_11".KP8.LED[#i]:=#led_val; "FB_KP8_DB_12".KP8.LED[#i]:=#led_val;
	            "FB_KP8_DB_13".KP8.LED[#i]:=#led_val; "FB_KP8_DB_14".KP8.LED[#i]:=#led_val; "FB_KP8_DB_15".KP8.LED[#i]:=#led_val; "FB_KP8_DB_16".KP8.LED[#i]:=#led_val;
	            "FB_KP8_DB_17".KP8.LED[#i]:=#led_val; "FB_KP8_DB_18".KP8.LED[#i]:=#led_val; "FB_KP8_DB_19".KP8.LED[#i]:=#led_val; "FB_KP8_DB_20".KP8.LED[#i]:=#led_val;
	            "FB_KP8_DB_21".KP8.LED[#i]:=#led_val; "FB_KP8_DB_22".KP8.LED[#i]:=#led_val; "FB_KP8_DB_23".KP8.LED[#i]:=#led_val; "FB_KP8_DB_24".KP8.LED[#i]:=#led_val;
	            "FB_KP8_DB_25".KP8.LED[#i]:=#led_val; "FB_KP8_DB_26".KP8.LED[#i]:=#led_val; "FB_KP8_DB_27".KP8.LED[#i]:=#led_val; "FB_KP8_DB_28".KP8.LED[#i]:=#led_val;
	        END_FOR;
	        RETURN;
	    END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[1].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_1".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[3].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_2".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[7].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_4".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[8].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_5".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[12].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_7".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[13].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_8".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[14].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_9".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[18].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_11".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[19].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_12".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[21].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_13".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[25].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_28".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[26].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_15".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[30].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_17".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[31].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_18".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[35].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_20".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[36].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_21".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[40].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_23".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[41].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_24".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[45].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_26".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[46].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_27".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[4].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[5].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[6].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_3".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[9].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[10].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[11].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_6".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[15].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[16].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[17].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_10".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[22].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[23].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[24].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_14".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[27].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[28].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[29].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_16".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[32].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[33].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[34].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_19".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[37].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[38].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[39].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_22".KP8.LED[#i]:=3; END_FOR; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[42].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[43].Hand_Aktiv_Intern OR "DB_Bad_Konfig".Bad_Konfig[44].Hand_Aktiv_Intern THEN FOR #i:=0 TO 7 DO "FB_KP8_DB_25".KP8.LED[#i]:=3; END_FOR; END_IF;
	
END_FUNCTION

