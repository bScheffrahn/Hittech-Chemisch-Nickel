	    END_IF;
	    #pw := "DB_Bad_Konfig".Bad_Konfig[44].IO_Aus.Prio_Einsetzen_WT;
	    "FB_KP8_DB_25".KP8.LED[6] := 0;
	    IF (#pw >= 1) AND (#pw <= 3) THEN
	        IF "DB_Bad_Konfig".Bad_Konfig[44].IO_Aus.LED_Einsetzen[#pw] THEN "FB_KP8_DB_25".KP8.LED[6] := 5; END_IF;
	    END_IF;
	    #pw := "DB_Bad_Konfig".Bad_Konfig[44].IO_Aus.Prio_Entnehmen_WT;
	    "FB_KP8_DB_25".KP8.LED[2] := 0;
	    IF (#pw >= 1) AND (#pw <= 3) THEN
	        IF "DB_Bad_Konfig".Bad_Konfig[44].IO_Aus.LED_Entnehmen[#pw] THEN
	            IF "DB_Bad_Konfig".Bad_Konfig[44].IO_Aus.LED_Vorwarn[#pw] THEN "FB_KP8_DB_25".KP8.LED[2] := 4; ELSE "FB_KP8_DB_25".KP8.LED[2] := 5; END_IF;
	        END_IF;
	    END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[42].IO_Aus.LED_Heizung_Aktiv OR "DB_Bad_Konfig".Bad_Konfig[43].IO_Aus.LED_Heizung_Aktiv OR "DB_Bad_Konfig".Bad_Konfig[44].IO_Aus.LED_Heizung_Aktiv THEN "FB_KP8_DB_25".KP8.LED[3] := 4; ELSE "FB_KP8_DB_25".KP8.LED[3] := 0; END_IF;
	    IF "DB_Bad_Konfig".Bad_Konfig[42].IO_Aus.LED_Stoerung OR "DB_Bad_Konfig".Bad_Konfig[43].IO_Aus.LED_Stoerung OR "DB_Bad_Konfig".Bad_Konfig[44].IO_Aus.LED_Stoerung THEN "FB_KP8_DB_25".KP8.LED[7] := 1; ELSE "FB_KP8_DB_25".KP8.LED[7] := 0; END_IF;
	
	    // Peripherie-Ausgaenge
	    "Pumpe Bad 8"      := "DB_Bad_Konfig".Bad_Konfig[8].IO_Aus.Pumpe;
	    "Pumpe Bad 12"     := "DB_Bad_Konfig".Bad_Konfig[12].IO_Aus.Pumpe;
	    "Pumpe Bad 14"     := "DB_Bad_Konfig".Bad_Konfig[14].IO_Aus.Pumpe;
	    "Pumpe Bad 18"     := "DB_Bad_Konfig".Bad_Konfig[18].IO_Aus.Pumpe;
	    "Pumpe Bad 19"     := "DB_Bad_Konfig".Bad_Konfig[19].IO_Aus.Pumpe;
	    "Pumpe Bad 21"     := "DB_Bad_Konfig".Bad_Konfig[21].IO_Aus.Pumpe;
	    // Bad 25: Netzschuetz + FU
	    "Netzschuetz Pumpe Bad 25"   := "DB_Bad_Konfig".Bad_Konfig[25].IO_Aus.Pumpe_FU_Netzschuetz;
	    "FU Pumpe Freigabe"          := "DB_Bad_Konfig".Bad_Konfig[25].IO_Aus.Pumpe_FU_Freigabe;
	    "Reset FU Pumpe"             := "DB_Bad_Konfig".Bad_Konfig[25].IO_Aus.Pumpe_FU_Reset;
	    "Pumpen_FU_Steuerwert"       := INT_TO_WORD(REAL_TO_INT("DB_Bad_Konfig".Bad_Konfig[25].Pumpe_FU_Soll * 276.48));
	    "Pumpe Bad 26"     := "DB_Bad_Konfig".Bad_Konfig[26].IO_Aus.Pumpe;
	    "Pumpe Bad 31"     := "DB_Bad_Konfig".Bad_Konfig[31].IO_Aus.Pumpe;
	    "Pumpe Bad 41"     := "DB_Bad_Konfig".Bad_Konfig[41].IO_Aus.Pumpe;
	    "Pumpe Bad 45"     := "DB_Bad_Konfig".Bad_Konfig[45].IO_Aus.Pumpe;
	
	    // Heizungen
	    "Regelung Heizung Bad 7"           := "DB_Bad_Konfig".Bad_Konfig[7].IO_Aus.Heizung_1_Regelung;
	    "Sicherheitsschuetz Heizung Bad 7"  := "DB_Bad_Konfig".Bad_Konfig[7].IO_Aus.Heizung_1_Sicherheit;
	    "Regelung Heizung Bad 8"           := "DB_Bad_Konfig".Bad_Konfig[8].IO_Aus.Heizung_1_Regelung;
	    "Sicherheitsschuetz Heizung Bad 8"  := "DB_Bad_Konfig".Bad_Konfig[8].IO_Aus.Heizung_1_Sicherheit;
	    "Regelung Heizung Bad 12"          := "DB_Bad_Konfig".Bad_Konfig[12].IO_Aus.Heizung_1_Regelung;
	    "Sicherheitsschuetz Heizung Bad 12" := "DB_Bad_Konfig".Bad_Konfig[12].IO_Aus.Heizung_1_Sicherheit;
	    "Regelung Heizung 1 Bad 25"        := "DB_Bad_Konfig".Bad_Konfig[25].IO_Aus.Heizung_1_Regelung;
	    "Regelung Heizung 2 Bad 25"        := "DB_Bad_Konfig".Bad_Konfig[25].IO_Aus.Heizung_2_Regelung;
	    "Sicherheitsschuetze Heizung 1 + 2 Bad 25" := "DB_Bad_Konfig".Bad_Konfig[25].IO_Aus.Heizung_1_Sicherheit OR "DB_Bad_Konfig".Bad_Konfig[25].IO_Aus.Heizung_2_Sicherheit;
	    "Regelung Heizung Bad 36"          := "DB_Bad_Konfig".Bad_Konfig[36].IO_Aus.Heizung_1_Regelung;
	    "Sicherheitsschuetz Heizung Bad 36" := "DB_Bad_Konfig".Bad_Konfig[36].IO_Aus.Heizung_1_Sicherheit;
	    "Regelung Heizung Bad 40"          := "DB_Bad_Konfig".Bad_Konfig[40].IO_Aus.Heizung_1_Regelung;
	    "Sicherheitsschuetz Heizung Bad 40" := "DB_Bad_Konfig".Bad_Konfig[40].IO_Aus.Heizung_1_Sicherheit;
	    "Regelung Heizung Bad 46"          := "DB_Bad_Konfig".Bad_Konfig[46].IO_Aus.Heizung_1_Regelung;
	    "Sicherheitsschuetz Heizung Bad 46" := "DB_Bad_Konfig".Bad_Konfig[46].IO_Aus.Heizung_1_Sicherheit;
	    "Freigabe Ultraschall Pos. 8"  := "DB_Bad_Konfig".Bad_Konfig[8].IO_Aus.Ultraschall_Freigabe;
	    "Freigabe Ultraschall Pos. 12" := "DB_Bad_Konfig".Bad_Konfig[12].IO_Aus.Ultraschall_Freigabe;
	
	    // Warenbewegung Bad 25 (X=WB2, Y=WB1 physisch)
	    "Warenbewegung 1 Bad 25 Netzschuetz"  := "DB_Bad_Konfig".Bad_Konfig[25].Warenbewegung_Y_Soll > 0.0;
	    "Warenbewegung 1 Bad 25 Freigabe FU" := "DB_Bad_Konfig".Bad_Konfig[25].Warenbewegung_Y_Soll > 0.0;
	    "Warenbewegung 1 Bad 25 Reset FU"    := "DB_Bad_Konfig".Bad_Konfig[25].WB1_Reset;
	    "Warenbewegung 2 Bad 25 Netzschuetz"  := "DB_Bad_Konfig".Bad_Konfig[25].Warenbewegung_X_Soll > 0.0;
	    "Warenbewegung 2 Bad 25 Freigabe FU" := "DB_Bad_Konfig".Bad_Konfig[25].Warenbewegung_X_Soll > 0.0;
	    "Warenbewegung 2 Bad 25 Reset FU"    := "DB_Bad_Konfig".Bad_Konfig[25].WB2_Reset;
	    "Warenbewegung 1 Bad 25 Sollwert FU" := INT_TO_WORD(REAL_TO_INT("DB_Bad_Konfig".Bad_Konfig[25].Warenbewegung_Y_Soll * 276.48));
	    "Warenbewegung 2 Bad 25 Sollwert FU" := INT_TO_WORD(REAL_TO_INT("DB_Bad_Konfig".Bad_Konfig[25].Warenbewegung_X_Soll * 276.48));
	
	    // Hupe
	    #hupe_sammel := FALSE;
	    FOR #b := 1 TO "c_Anzahl_Bad" DO IF "DB_Bad_Konfig".Bad_Konfig[#b].Hupe THEN #hupe_sammel := TRUE; END_IF; END_FOR;
	    "Masch.Leuchte 1 Anlage Hupe" := #hupe_sammel;
	END_IF;
	
END_FUNCTION

